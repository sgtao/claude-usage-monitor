#!/usr/bin/env bash
# =============================================================================
# pre-push — push 前に claude plugin validate / test を実行する
#
# push 対象のコミット（作業ツリーではなく、実際に送られる内容）を一時フォルダへ
# 取り出し、そこで次を実行する。どちらかが失敗すると push を中止する。
#   claude plugin validate .
#   claude plugin test .
#
# 有効化: bash scripts/setup-hooks.sh
# 回避  : git push --no-verify
# =============================================================================
set -euo pipefail

# ─── 色定義（TTY 時のみ有効） ─────────────────────────────────────────────────
if [ -t 2 ]; then
  C_INFO='\033[0;34m' C_ERR='\033[0;31m' C_OK='\033[0;32m' C_BOLD='\033[1m' C_RESET='\033[0m'
else
  C_INFO='' C_ERR='' C_OK='' C_BOLD='' C_RESET=''
fi
info()    { printf "${C_INFO}${C_BOLD}[pre-push]${C_RESET} %s\n" "$*" >&2; }
error()   { printf "${C_ERR}${C_BOLD}[pre-push]${C_RESET} %s\n" "$*" >&2; }
success() { printf "${C_OK}${C_BOLD}[pre-push]${C_RESET} %s\n" "$*" >&2; }

# ─── push 対象のコミットを重複なく集める（標準入力: <ref> <local sha> <ref> <remote sha>） ─
shas=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # ブランチ・タグの削除（local sha が全部 0）は対象なし
  [[ "${local_sha}" =~ ^0+$ ]] && continue
  case " ${shas} " in
    *" ${local_sha} "*) ;;
    *) shas="${shas} ${local_sha}" ;;
  esac
done

if [[ -z "${shas}" ]]; then
  exit 0
fi

if ! command -v claude &>/dev/null; then
  error "claude コマンドが見つかりません。PATH を確認してください（回避: git push --no-verify）"
  exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT

# ─── 1 ステップ実行（成功時は要約のみ、失敗時は出力を全部表示して中止） ───────
run_step() {
  local name="$1" sha="$2"; shift 2
  local log="${tmp}/${sha}-${name}.log"
  if ( cd "${tmp}/${sha}" && "$@" </dev/null ) >"${log}" 2>&1; then
    info "  ✔ ${name}"
  else
    cat "${log}" >&2
    error "claude plugin ${name} が失敗したため、push を中止しました（${sha:0:7}）"
    exit 1
  fi
}

for sha in ${shas}; do
  info "検証: ${sha:0:7}"
  mkdir -p "${tmp}/${sha}"
  git archive "${sha}" | tar -x -C "${tmp}/${sha}"
  run_step validate "${sha}" claude plugin validate .
  run_step test "${sha}" claude plugin test .
done

success "validate / test ともに成功しました"
